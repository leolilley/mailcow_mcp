# ---------------------------------------------------------------------------
# Mailcow connection
# ---------------------------------------------------------------------------
MAILCOW_API_URL=https://your-mailcow-server.com
MAILCOW_API_KEY=your-32-character-api-key-here

# read-only or read-write.
#
# Prefer read-only. The mailcow API issues separate read-only and read-write
# keys, and this server cannot grant itself more than the key allows — so the
# key is the one control that holds regardless of what the model is persuaded
# to attempt.
MAILCOW_API_ACCESS_TYPE=read-only

MAILCOW_VERIFY_SSL=true

# Restrict the key to this server's source address in the mailcow UI
# (System -> Configuration -> API, "Allow API access from"). mailcow requires
# an allowlist; use it rather than 0.0.0.0/0.

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------
# stdio (default) runs as a child process of a local client such as Claude
# Desktop or Claude Code. Nothing listens on the network.
#
# http serves Streamable HTTP for remote clients that connect over the network
# (Claude on the web, ChatGPT). Everything in the next section applies only to
# this mode.
MCP_TRANSPORT=stdio

# ---------------------------------------------------------------------------
# HTTP transport (only read when MCP_TRANSPORT=http)
# ---------------------------------------------------------------------------
# Interface to bind. Keep this on loopback or a private address and put a
# reverse proxy in front: this server does not terminate TLS.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000

# The public origin clients reach this server at. Required in http mode, with
# no default: OAuth redirect URIs and both discovery documents are built from
# it, and there is no safe value to guess.
#
# Must be https unless the host is localhost or 127.0.0.1. This is enforced,
# not advised: the SDK rejects a non-https issuer outright, so a value like
# http://0.0.0.0:3000 does not start at all.
MCP_PUBLIC_URL=https://mcp.example.com

# Operator password for the OAuth consent screen. No default and no fallback:
# the server refuses to start in http mode without one, and requires at least
# 24 characters.
#
# Use something random, not something memorable. The consent route throttles
# how often a password is checked, but it cannot tell you from an attacker:
# /authorize needs no authentication and dynamic client registration is open,
# so anyone who can reach this server can render a consent page. Entropy is
# what actually bounds guessing here, and this is the only credential between
# the internet and your mail server's API.
MCP_OAUTH_PASSWORD=

# Honour X-Forwarded-For / X-Forwarded-Proto. Enable only when a proxy you
# control sits in front, because a direct caller can otherwise forge both.
MCP_TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Tool exposure
# ---------------------------------------------------------------------------
# Both default to false, and only the exact string "true" enables them.
#
# Tools excluded by these flags are never registered, so they do not appear in
# tools/list at all. A model cannot see them, cannot be talked into calling
# them, and cannot report that it was blocked.
#
# These three flags apply to MCP_TRANSPORT=http only. Over stdio every tool is
# registered, because the caller is whoever launched the process.
#
# MCP_ENABLE_DESTRUCTIVE_TOOLS covers delete_domain, delete_mailbox,
# delete_user, delete_dkim_key, update_dkim_key, delete_queue_items,
# delete_sync_job, update_domain and create_dkim_key: tools that permanently
# destroy mail, or that stop mail flow or break DKIM signing silently until
# DNS catches up.
#
# MCP_ENABLE_OUTBOUND_TOOLS covers send_email, which lets a model send mail
# from your domains.
#
# MCP_ENABLE_CREDENTIAL_TOOLS covers update_mailbox, update_user,
# create_mailbox, create_user, create_sync_job and update_sync_job — tools that
# set or accept a credential. They destroy nothing, which is exactly why a
# deny-list built around "delete" misses them, but each mints or takes over an
# identity that then authenticates to the mail system directly, outside this
# server. Resetting postmaster@ hands over the domain; creating
# billing@yourdomain with a known password is a phishing primitive.
#
# Think hard before enabling any of these on MCP_TRANSPORT=http. A remote
# deployment is driven by a model that may have just read an attacker-authored
# email.
MCP_ENABLE_DESTRUCTIVE_TOOLS=false
MCP_ENABLE_CREDENTIAL_TOOLS=false
MCP_ENABLE_OUTBOUND_TOOLS=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
